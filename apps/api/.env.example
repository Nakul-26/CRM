NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://sales_platform:sales_platform@localhost:5434/sales_platform

REDIS_URL=redis://localhost:6380

# Generate real secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-64-char-secret-before-running-anything-real
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-secret-before-running-anything-real
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGIN=http://localhost:3000

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@sales-platform.local

WEB_APP_URL=http://localhost:3000

# "mock" (default) needs nothing else below — it simulates checkout entirely
# in-app, no external account. Set to "stripe" and fill in real test-mode
# keys to charge through the actual Stripe API instead.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Unset (default) needs nothing else below — POST /support/inbound-email
# always rejects, so this feature is inert. Set INBOUND_EMAIL_WEBHOOK_SECRET
# once a real inbound-email-parsing provider (e.g. a Postmark/Mailgun
# inbound route) is configured to forward parsed customer replies here.
INBOUND_EMAIL_DOMAIN=inbound.sales-platform.local
INBOUND_EMAIL_WEBHOOK_SECRET=

# "in-process" (default) needs nothing else below — the audit log is written
# synchronously from the local event bus. Set to "rabbitmq" to route audit
# writes through a durable queue instead (requires the rabbitmq service in
# docker-compose.yml to be running).
EVENT_BUS_TRANSPORT=in-process
RABBITMQ_URL=amqp://guest:guest@localhost:5673

# "postgres" (default) needs nothing else below — tsvector + pg_trgm already
# power global search. Set to "opensearch" to route search through a real
# OpenSearch index instead (requires the opensearch service in
# docker-compose.yml, and running `pnpm search:reindex` once to backfill it).
SEARCH_PROVIDER=postgres
OPENSEARCH_URL=http://localhost:9201

# "in-process" (default) needs nothing else below — a subscription's
# payment-failure dunning (retry with backoff, cancel on exhaustion) runs
# off a Postgres job table + cron. Set to "temporal" to run it as a durable
# Temporal workflow instead (requires the temporal service in
# docker-compose.yml to be running).
WORKFLOW_ENGINE=in-process
TEMPORAL_ADDRESS=localhost:7234
TEMPORAL_NAMESPACE=default
# Comma-separated ms, exactly 3 values — overrides the production day-scale
# dunning backoff schedule. Test-only; leave unset in dev/production.
DUNNING_RETRY_DELAYS_MS=

# Additive, not a swap: password login always works regardless of this flag.
# Set to true to also allow logging in via Keycloak/OIDC for an
# already-provisioned local user (matched by verified email) — requires the
# keycloak service in docker-compose.yml to be running. Client secret below
# matches docker/keycloak/realm-export.json's seeded dev client.
AUTH_OIDC_ENABLED=false
OIDC_ISSUER_URL=http://localhost:8082/realms/sales-platform
OIDC_CLIENT_ID=sales-platform-api
OIDC_CLIENT_SECRET=dev-oidc-client-secret-change-me

# false (default) needs nothing else below — this app's own
# NotificationsModule keeps serving /notifications in-process, exactly as
# before. Set to true once apps/notifications-service is deployed
# separately (requires EVENT_BUS_TRANSPORT=rabbitmq above — validated at
# boot — since that's the only way events reach the extracted service).
NOTIFICATIONS_SERVICE_ENABLED=false
