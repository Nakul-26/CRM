NODE_ENV=development
PORT=4002

# A separate logical database from apps/api's own DATABASE_URL — same
# Postgres container/port, different database name. Created automatically by
# `pnpm db:migrate` if it doesn't exist yet. See
# docs/decisions/0018-microservices-split-phase18-scope.md.
DATABASE_URL=postgres://sales_platform:sales_platform@localhost:5434/sales_platform_notifications

# Required, not optional — unlike apps/api's EVENT_BUS_TRANSPORT=rabbitmq
# opt-in, this service only exists at all once the split is turned on, and
# it has no way to receive domain events other than this exchange.
RABBITMQ_URL=amqp://guest:guest@localhost:5673

# Must match apps/api's own JWT_ACCESS_SECRET exactly — this service
# verifies the same access tokens apps/api issues, it does not issue its own.
JWT_ACCESS_SECRET=replace-with-a-random-64-char-secret-before-running-anything-real

CORS_ORIGIN=http://localhost:3000
