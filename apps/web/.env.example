NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000

# Unset by default — the gateway proxy routes /notifications/* to
# API_INTERNAL_URL (apps/api serving it in-process) unless this is set. Set
# it (and NOTIFICATIONS_SERVICE_ENABLED=true in apps/api/.env) once
# apps/notifications-service is deployed separately.
NOTIFICATIONS_SERVICE_URL=

# "Sign in with SSO" — additive, off by default. Set NEXT_PUBLIC_OIDC_ENABLED=true
# (and mirror AUTH_OIDC_ENABLED=true in apps/api/.env) to show the button and
# enable the callback route. OIDC_ISSUER_URL/OIDC_REDIRECT_URI are server-only
# and match apps/api's OIDC_ISSUER_URL / docker/keycloak/realm-export.json's
# seeded client redirect URI.
NEXT_PUBLIC_OIDC_ENABLED=false
OIDC_ISSUER_URL=http://localhost:8082/realms/sales-platform
OIDC_CLIENT_ID=sales-platform-api
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
